<Project>
  <!-- 全プロジェクト共通のビルド設定。配下の各csprojに自動で読み込まれる
       （プロジェクト固有の設定は各csproj側に置く） -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 警告（null許容の見落とし・非推奨API等）を放置したままmasterへ入らないようにする。
         現状警告ゼロのため、新たな警告はその変更（依存パッケージの更新を含む）で直す運用 -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
