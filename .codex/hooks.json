{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/guard-real-run.sh\"",
            "timeout": 10,
            "statusMessage": "実ツイート実行の防止チェック"
          }
        ]
      }
    ]
  }
}
