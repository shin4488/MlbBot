{
  "permissions": {
    "deny": [
      "Bash(terraform apply)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy)",
      "Bash(terraform destroy *)",
      "Bash(make *tf-apply*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-real-run.sh\"",
            "timeout": 10,
            "statusMessage": "実ツイート実行の防止チェック"
          }
        ]
      }
    ]
  }
}
