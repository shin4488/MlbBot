<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- ローカルでは dotnet run で直接実行する（Lambdaからは TwitterMlbBotExecution 経由で参照される） -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- internalクラス（BotRunner・TweetComposer等）をテストプロジェクトから参照できるようにする -->
    <InternalsVisibleTo Include="TwitterMlbBotExecution.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.11" />
  </ItemGroup>

</Project>
