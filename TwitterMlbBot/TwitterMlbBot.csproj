<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- ローカルでは dotnet run で直接実行する（Lambdaからは TwitterMlbBotExecution 経由で参照される） -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- internalクラス（TwitterService等）をテストプロジェクトから参照できるようにする -->
    <InternalsVisibleTo Include="TwitterMlbBotExecution.Tests" />
  </ItemGroup>

</Project>
